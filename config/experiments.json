{
  "experiments": {
    "E1": {
      "title": "Policy comparison",
      "workload": {"generate": 20, "seed": 42},
      "policies": ["latency", "cloud", "capacity", "topsis"]
    },
    "E2": {
      "title": "Overload",
      "workload": {"generate": 10, "seed": 7, "sensitivity_mix": {"high": 1.0}},
      "policies": ["latency", "capacity"],
      "preload": {"edge-1": 0.9}
    },
    "E3": {
      "title": "Unauthorised tenant access",
      "workload": {"file": "examples/tasks_sample.csv"},
      "policy": "capacity",
      "actor": "hospital-b",
      "target_tenant": "hospital-a"
    },
    "E4": {
      "title": "Node capacity and latency change",
      "workload": {"generate": 20, "seed": 42},
      "policy": "capacity",
      "changes": [
        {"edge-1": {"cpu_cores": 8}},
        {"cloud-1": {"base_latency_ms": 150}}
      ]
    }
  }
}
